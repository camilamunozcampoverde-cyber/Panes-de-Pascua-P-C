# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_SHEETS_SPREADSHEET_ID: Optional default Spreadsheet ID for Pan & Canela (tab "Pedidos").
# Can also be set or created directly from the app after signing in with Google.
GOOGLE_SHEETS_SPREADSHEET_ID=""

# GOOGLE_APPS_SCRIPT_URL: Optional Web App URL deployed from /apps-script/Code.gs.
# When set on the server, customers can register orders without signing in to Google.
GOOGLE_APPS_SCRIPT_URL=""

# GOOGLE_APPS_SCRIPT_SECRET: Optional shared token checked by /apps-script/Code.gs (kept server-side only).
GOOGLE_APPS_SCRIPT_SECRET=""
